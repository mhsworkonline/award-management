NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: only needed if a custom domain gets attached in Vercel later.
# Used to build absolute URLs for link-preview metadata (e.g. the WhatsApp
# thumbnail on the public /apply form). Until then, this is left unset and
# the app falls back to Vercel's own assigned *.vercel.app URL automatically.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
